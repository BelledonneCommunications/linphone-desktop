set(MSI_WIX_PROGRAM "@WIX_PROGRAM@")
set(MSI_ARCHITECTURE "@CPACK_WIX_ARCHITECTURE@")
set(MSI_LOCALIZATION_DIR "@LINPHONE_MSI_LOCALIZATION_DIR@")
set(MSI_EXTRA_CULTURES "@LINPHONE_MSI_EXTRA_CULTURES@")
set(MSI_EMBED_SCRIPT "@LINPHONE_MSI_LOCALIZATION_DIR@/EmbedLanguageTransform.ps1")

function(msi_language_of CULTURE OUTPUT)
	set(LOCALIZATION "${MSI_LOCALIZATION_DIR}/${CULTURE}.wxl")
	if(NOT EXISTS "${LOCALIZATION}")
		message(FATAL_ERROR "Missing MSI localization ${LOCALIZATION}.")
	endif()
	file(STRINGS "${LOCALIZATION}" LANGUAGE_LINE REGEX "Id=\"LinphoneLanguage\"")
	string(REGEX MATCH "Value=\"([0-9]+)\"" LANGUAGE_MATCH "${LANGUAGE_LINE}")
	if(NOT CMAKE_MATCH_1)
		message(FATAL_ERROR "No LinphoneLanguage string in ${LOCALIZATION}.")
	endif()
	set(${OUTPUT} "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

function(msi_run)
	execute_process(COMMAND ${ARGN} RESULT_VARIABLE RESULT OUTPUT_VARIABLE OUTPUT ERROR_VARIABLE OUTPUT)
	if(NOT RESULT EQUAL 0)
		string(REPLACE ";" " " COMMAND_LINE "${ARGN}")
		message(FATAL_ERROR "MSI language step failed (${RESULT}): ${COMMAND_LINE}\n${OUTPUT}")
	endif()
endfunction()

set(MSI_PACKAGES "")
foreach(PACKAGE ${CPACK_PACKAGE_FILES})
	if(PACKAGE MATCHES "\\.msi$")
		list(APPEND MSI_PACKAGES "${PACKAGE}")
	endif()
endforeach()

if(MSI_PACKAGES AND MSI_EXTRA_CULTURES)
	file(GLOB MSI_SOURCES "${CPACK_TOPLEVEL_DIRECTORY}/*.wxs")
	if(NOT MSI_SOURCES)
		message(FATAL_ERROR "No WiX sources found in ${CPACK_TOPLEVEL_DIRECTORY}.")
	endif()
	set(MSI_SOURCE_ARGUMENTS "")
	foreach(SOURCE ${MSI_SOURCES})
		list(APPEND MSI_SOURCE_ARGUMENTS -src "${SOURCE}")
	endforeach()
	foreach(PACKAGE ${MSI_PACKAGES})
		foreach(CULTURE ${MSI_EXTRA_CULTURES})
			msi_language_of(${CULTURE} LANGUAGE)
			set(WORK_DIR "${CPACK_TOPLEVEL_DIRECTORY}/language-${CULTURE}")
			file(REMOVE_RECURSE "${WORK_DIR}")
			file(MAKE_DIRECTORY "${WORK_DIR}")
			message(STATUS "Embedding ${CULTURE} (${LANGUAGE}) language transform into ${PACKAGE}")
			msi_run("${MSI_WIX_PROGRAM}" build -arch ${MSI_ARCHITECTURE} -ext WixToolset.UI.wixext
				-culture ${CULTURE} -loc "${MSI_LOCALIZATION_DIR}/${CULTURE}.wxl" ${MSI_SOURCE_ARGUMENTS}
				-intermediatefolder "${WORK_DIR}/obj" -out "${WORK_DIR}/${CULTURE}.msi")
			msi_run("${MSI_WIX_PROGRAM}" msi transform -t language "${PACKAGE}" "${WORK_DIR}/${CULTURE}.msi"
				-intermediatefolder "${WORK_DIR}/obj" -out "${WORK_DIR}/${LANGUAGE}.mst")
			msi_run(powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "${MSI_EMBED_SCRIPT}"
				-Msi "${PACKAGE}" -Transform "${WORK_DIR}/${LANGUAGE}.mst" -Language ${LANGUAGE})
		endforeach()
	endforeach()
endif()
